# This file is used by the API server process, NEVER by the public static site.
# DO NOT commit credentials. Use an EnvironmentFile owned by root (0600).
ADCS_PROJECT_PATH=/opt/adcs_python
ADCS_CONFIG_PATH=/etc/adcs/adcs.yaml
ADCS_WEB_USERNAME=admin
ADCS_WEB_PASSWORD_HASH=pbkdf2_sha256$REPLACE_WITH_THE_GENERATED_HASH
ADCS_WEB_SESSION_DB=/var/lib/adcs-web/sessions.sqlite3
ADCS_WEB_LOCK_DIR=/var/lib/adcs-web/locks
ADCS_WEB_TOKEN_TTL=3600
ADCS_WEB_HOST=127.0.0.1
ADCS_WEB_PORT=8001
# Exact browser origins for a site on a DIFFERENT domain, comma-separated.
# On a same-origin reverse proxy, the Origin header matches this domain if present.
ADCS_WEB_ALLOWED_ORIGINS=https://console.adcs.example.org
